{
  "description": "Quantum-walk OpenMP strong scaling on cn07",
  "repo_root": ".",
  "binary": "build-standalone-cn07/feynman.x",
  "vary": "omp_threads",
  "values": [
    8,
    16
  ],
  "repeat": 1,
  "perf_stat": {
    "events": [
      "task-clock,context-switches,cpu-migrations,page-faults",
      "{cycles,instructions,stall_backend,stall_backend_cache,l1d_cache,l1d_cache_refill,l2d_cache,l2d_cache_refill}"
    ]
  },
  "feynman_env": {
    "FEYNMAN_HISTORY_TIMINGS": "1",
    "OMP_DYNAMIC": "FALSE",
    "OMP_PLACES": "cores",
    "OMP_PROC_BIND": "close"
  },
  "batch_size": 1,
  "fraction": 1.0,
  "threshold": 0.0,
  "cases": [
    {
      "checkpoint_policy": "thirds"
    }
  ],
  "circuit": {
    "generator": "qwalk",
    "n": 6,
    "it": 31
  },
  "input_statevector": {
    "generator": "ket0"
  },
  "output_bitstrings": {
    "generator": "one_interval",
    "count": 1
  },
  "timeout_seconds": 1200,
  "output_root": "data/outputs/experiments",
  "notes": "cn07 perf-stat comparison at 8 and 16 OpenMP threads. Per-history timing is enabled for load-balance analysis.",
  "ranks": 1
}
