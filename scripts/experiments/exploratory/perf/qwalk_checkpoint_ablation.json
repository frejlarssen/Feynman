{
  "description": "qwalk_checkpoint_ablation",
  "repo_root": ".",
  "vary": "batch_size",
  "values": [
    32
  ],
  "repeat": 5,
  "ranks": 8,
  "feynman_env": {
    "OMP_NUM_THREADS": "4"
