  "output_bitstrings": {
    "generator": "one_interval",
    "count": 10
  },
  "cases": [
    {
      "p": 0,
      "r": 0
    },
    {
      "p": 176,
      "r": 176
    },
    {
      "p": null,
      "r": null
    }
  ],
  "notes": "Checkpoint ablation: no_cp vs fixed_cp vs autotuned_cp on qwalk.",
  "binary": "build-release/sv_prefetcher_subset_mpi.x"
}
