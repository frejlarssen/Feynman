{
  "experiment_name": "google_rqc_selected_accuracy_cross_seeded_smoke",
  "repo_root": ".",
  "output_root": "data/outputs/validation",
  "binary": "build-cloud/cloud_task.x",
  "mpirun": "mpirun",
  "ranks": 1,
  "feynman_env": {
    "OMP_NUM_THREADS": "1"
  },
  "circuit": {
    "generator": "google_rqc",
    "rows": 2,
    "cols": 4,
    "cycles": 1,
    "seed": 1,
    "variant": "sycamore"
  },
  "input_statevector": {
    "generator": "ket0",
    "size": 1
  },
  "output_bitstrings": {
    "generator": "random_uniform",
    "size": 1,
    "count": 64,
    "seed": 11,
    "n_qubits": 8
  },
  "reference": {
    "name": "exact_reference",
    "fraction": 1.0,
    "threshold": 0.0,
    "verbosity": 1
  },
  "cases": [
    {
      "name": "fraction_0.5_cross_seeded",
      "fraction": 0.5,
      "threshold": 0.0,
      "verbosity": 1,
      "population_estimator": "cross_seeded",
      "history_seeds": [1, 2]
    }
  ],
  "nonzero_eps": 1e-12
}
