{
  "description": "google_rqc_selected_accuracy_fraction",
  "feynman_env": {
    "OMP_NUM_THREADS": "1"
  },
  "circuit": {
    "generator": "google_rqc",
    "rows": 2,
    "cols": 4,
    "cycles": 1,
    "seed": 1,
    "variant": "sycamore"
  },
  "input_statevector": {
    "generator": "ket0"
  },
  "output_bitstrings": {
    "generator": "random_uniform",
    "count": 256,
    "seed": 11
  },
  "vary": "fraction",
  "values": [0.99, 0.9, 0.75, 0.5, 0.25, 0.1],
  "nonzero_eps": 1e-26
}
