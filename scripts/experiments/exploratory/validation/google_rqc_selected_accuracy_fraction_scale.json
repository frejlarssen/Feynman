{
  "experiment_name": "google_rqc_selected_accuracy_fraction_scale",
  "repo_root": ".",
  "output_root": "data/outputs/validation",
  "binary": "build-cloud/cloud_task.x",
  "mpirun": "mpirun",
  "ranks": 1,
  "feynman_env": {
    "OMP_NUM_THREADS": "1"
  },
  "circuit": {
    "generator": "google_rqc",
    "rows": 2,
    "cols": 5,
    "cycles": 1,
    "seed": 1,
    "variant": "sycamore"
  },
  "input_statevector": {
    "generator": "ket0",
    "size": 2
  },
  "output_bitstrings": {
    "generator": "random_uniform",
    "size": 2,
    "count": 1024,
    "seed": 11,
    "n_qubits": 10
  },
  "reference": {
    "name": "exact_reference",
    "fraction": 1.0,
    "threshold": 0.0,
    "verbosity": 1
  },
  "cases": [
    {
      "name": "fraction_0.99",
      "fraction": 0.99,
      "threshold": 0.0,
      "verbosity": 1,
      "population_estimator": "cross_seeded",
      "history_seeds": [1, 2]
    },
    {
      "name": "fraction_0.9",
      "fraction": 0.9,
      "threshold": 0.0,
      "verbosity": 1,
      "population_estimator": "cross_seeded",
      "history_seeds": [1, 2]
    },
    {
      "name": "fraction_0.75",
      "fraction": 0.75,
      "threshold": 0.0,
      "verbosity": 1,
      "population_estimator": "cross_seeded",
      "history_seeds": [1, 2]
    },
    {
      "name": "fraction_0.5",
      "fraction": 0.5,
      "threshold": 0.0,
      "verbosity": 1,
      "population_estimator": "cross_seeded",
      "history_seeds": [1, 2]
    },
    {
      "name": "fraction_0.25",
      "fraction": 0.25,
      "threshold": 0.0,
      "verbosity": 1,
      "population_estimator": "cross_seeded",
      "history_seeds": [1, 2]
    },
    {
      "name": "fraction_0.10",
      "fraction": 0.10,
      "threshold": 0.0,
      "verbosity": 1,
      "population_estimator": "cross_seeded",
      "history_seeds": [1, 2]
    }
  ],
  "nonzero_eps": 1e-26
}
